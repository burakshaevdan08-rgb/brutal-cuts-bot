# ============================================================
# BRUTAL CUTS · Telegram bot — пример настроек
# Скопируйте файл:  cp .env.example .env
# и подставьте свои значения.
# ============================================================

# --- Telegram -------------------------------------------------
# Токен бота от @BotFather (формат: 123456789:AAH...)
BOT_TOKEN=8693506877:AAErlUW5eKCj0TZLhR1vqhmMmkVP-bG_W0o
# Telegram ID администратора (узнать можно у @userinfobot)
ADMIN_ID=1122752018

# --- Режим CRM ------------------------------------------------
# True  — бот работает автономно на встроенном Mock-движке
#         (филиалы, мастера, расписание и записи в памяти процесса),
#         ключи YClients не нужны.
# False — бот работает с реальным YClients API
#         (нужны YCLIENTS_PARTNER_TOKEN и YCLIENTS_USER_TOKEN).
USE_MOCK_CRM=True
# Имитация сетевой задержки Mock-CRM в миллисекундах (0 — без задержки)
MOCK_LATENCY_MS=120

# --- YClients (нужно только при USE_MOCK_CRM=False) -----------
YCLIENTS_API_URL=https://api.yclients.com/api/v1
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_USER_TOKEN=
# ID филиалов в YClients через запятую, например: 111111,222222
YCLIENTS_COMPANY_IDS=

# --- Общие настройки ------------------------------------------
# Часовой пояс клуба (IANA)
TIMEZONE=Europe/Moscow
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- База данных (SQLAlchemy async) ---------------------------
# Локально (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/brutal_cuts.db
# PostgreSQL (в docker-compose подставляется автоматически):
# DATABASE_URL=postgresql+asyncpg://brutal:brutal@localhost:5432/brutal_cuts

# --- Хранилище FSM --------------------------------------------
# False — MemoryStorage (состояния теряются при перезапуске)
# True  — RedisStorage (состояния переживают перезапуск)
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0
