# ======================================================================
#  BRUTAL CUTS · Telegram-бот барбершопов — пример настроек
#
#  Быстрый старт:   cp .env.example .env
#  Затем заполните ДВЕ обязательные переменные: BOT_TOKEN и ADMIN_ID.
#  Всё остальное уже настроено для запуска «из коробки» на встроенном
#  Mock-CRM: платные ключи YClients не нужны.
# ======================================================================


# ──────────────────────────────────────────────────────────────────────
#  1. TELEGRAM — обязательно
# ──────────────────────────────────────────────────────────────────────

# Токен бота от @BotFather (формат: 123456789:AAH...).
# Бот проверяет токен при старте и сразу сообщает, если он неверный.
BOT_TOKEN=123456789:AAH_replace_me_with_real_token_from_BotFather

# Ваш Telegram ID (узнать: @userinfobot). Этот человек:
#   • получает алерты о негативных отзывах 1–3★ и стартовое сообщение бота;
#   • единственный видит debug-команды /test_reminder_24h, /test_reminder_2h,
#     /test_review, /test_digest;
#   • по умолчанию становится «клиентом» для демо-записей
#     (python -m scripts.seed_demo_data).
# Перед проверкой напишите боту /start, иначе Telegram не даст ему писать вам первым.
ADMIN_ID=123456789


# ──────────────────────────────────────────────────────────────────────
#  2. РЕЖИМ CRM
# ──────────────────────────────────────────────────────────────────────

# True  — встроенный автономный Mock-CRM: 2 филиала, 12 мастеров, прайс по грейдам,
#         динамическое расписание, лояльность. Никаких внешних API и ключей.
# False — зарезервировано под боевую CRM (YClients). В этом репозитории готов
#         интерфейс BaseCRMService, а адаптер YClients не входит: с False бот
#         запросит YCLIENTS_* и затем сообщит, что адаптер не подключён.
USE_MOCK_CRM=True

# Имитация сетевой задержки Mock-CRM, мс (0 — без задержки; удобно для демо ≈ 100–150).
MOCK_LATENCY_MS=120

# Файл, где Mock-CRM хранит записи и счётчик ID: перезапуск бота не освобождает
# занятые слоты. Путь от корня проекта; значение none — хранить только в памяти.
MOCK_STATE_FILE=data/mock_crm_state.json


# ──────────────────────────────────────────────────────────────────────
#  3. YCLIENTS — нужно только при USE_MOCK_CRM=False
# ──────────────────────────────────────────────────────────────────────
YCLIENTS_API_URL=https://api.yclients.com/api/v1
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_USER_TOKEN=
# ID филиалов в YClients через запятую, например: 111111,222222
YCLIENTS_COMPANY_IDS=


# ──────────────────────────────────────────────────────────────────────
#  4. ПЛАНИРОВЩИК: напоминания, запросы оценки, дайджест
# ──────────────────────────────────────────────────────────────────────

# Как часто бот ищет записи для напоминаний (24 ч и 2 ч до визита) и запросов
# оценки (через 45 минут после визита), сек. От 10 до 3600.
SCHEDULER_POLL_SECONDS=60

# Время утреннего дайджеста для барберов, HH:MM по часовому поясу клуба.
DIGEST_TIME=09:30

# Чат для дайджестов мастеров без личного чата. Не задано — уходит на ADMIN_ID.
# DIGEST_CHAT_ID=-1001234567890

# Личные чаты мастеров: «ID мастера в CRM:chat_id» через запятую. Указанные мастера
# получают расписание в личку, остальные — в чат дайджеста.
# BARBER_CHAT_IDS=1:111111111,7:222222222


# ──────────────────────────────────────────────────────────────────────
#  5. ОТЗЫВЫ (Review Gatekeeping)
# ──────────────────────────────────────────────────────────────────────

# Куда вести гостей, поставивших 5★: страницы отзывов филиалов на Яндекс.Картах.
# Формат: ID_филиала=URL, несколько — через «;». Не задано — кнопка ведёт на точку
# филиала на карте. Гости с оценкой 1–3★ ссылку НЕ получают: их претензия уходит ADMIN_ID.
# BRANCH_REVIEW_URLS=1=https://yandex.ru/maps/org/123456789/reviews/;2=https://yandex.ru/maps/org/987654321/reviews/


# ──────────────────────────────────────────────────────────────────────
#  6. ОБЩИЕ НАСТРОЙКИ
# ──────────────────────────────────────────────────────────────────────

# Часовой пояс клуба (IANA): по нему считаются «завтра в 16:00», дайджест и расписание.
TIMEZONE=Europe/Moscow

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ──────────────────────────────────────────────────────────────────────
#  7. БАЗА ДАННЫХ (SQLAlchemy 2.0, async)
# ──────────────────────────────────────────────────────────────────────

# По умолчанию — локальный файл SQLite (режим WAL): таблицы и недостающие колонки
# создаются при старте бота. Путь считается от текущей папки — запускайте из корня проекта.
DATABASE_URL=sqlite+aiosqlite:///./brutal_cuts.db
# Продакшн — PostgreSQL. Строки postgres://… и postgresql://… принимаются
# и автоматически переводятся на драйвер asyncpg:
# DATABASE_URL=postgresql+asyncpg://brutal:brutal@localhost:5432/brutal_cuts


# ──────────────────────────────────────────────────────────────────────
#  8. ХРАНИЛИЩЕ FSM (состояния диалогов)
# ──────────────────────────────────────────────────────────────────────

# False — MemoryStorage: проще всего, но состояния теряются при перезапуске.
# True  — RedisStorage: незавершённые записи переживают перезапуск.
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0

# При запуске через `docker compose up` значения DATABASE_URL, USE_REDIS и REDIS_URL
# подменяются на сервисы postgres и redis из docker-compose.yml — править их здесь не нужно.
